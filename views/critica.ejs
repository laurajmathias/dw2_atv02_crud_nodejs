<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="pagina-critica">

    <section class="titulo-pagina">

        <h1>O que a crítica diz?</h1>

        <p>
            Uma visão sobre os musicais que fazem parte da nossa seleção.
        </p>

        <a href="/criticas/cadastrar" class="botao-cadastrar">
            + Cadastrar Crítica
        </a>

    </section>


    <section class="criticas-container">

        <% criticas.forEach((critica) => { %>

            <article class="critica-item">

                <div class="critica-capa">

                    <img
                        src="/Images/<%= critica.imagem %>"
                        alt="<%= critica.nome %>"
                    >

                </div>


                <div class="critica-conteudo">

                    <span class="numero-musical">
                        <%= String(critica.id).padStart(2, '0') %>
                    </span>

                    <h2>
                        <%= critica.nome %>
                    </h2>

                    <p class="texto-critica">
                        <%= critica.critica %>
                    </p>


                    <div class="dados-critica">

                        <div>

                            <strong>Nota</strong>

                            <span>
                                <%= critica.nota %>
                            </span>

                        </div>


                        <div>

                            <strong>Indicações</strong>

                            <span>
                                <%= critica.indicações %>
                            </span>

                        </div>


                        <div>

                            <strong>Premiações</strong>

                            <span>
                                <%= critica.premiações %>
                            </span>

                        </div>

                    </div>


                    <div class="acoes-critica">

                        <a
                            href="/criticas/editar/<%= critica.id %>"
                            class="botao-editar"
                        >
                            Editar
                        </a>

                        <a
                            href="/criticas/excluir/<%= critica.id %>"
                            class="botao-excluir"
                        >
                            Excluir
                        </a>

                    </div>

                </div>

            </article>

        <% }); %>

    </section>

</main>

<%- include('partials/footer') %>