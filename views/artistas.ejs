<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="pagina-artistas">

    <section class="titulo-pagina">

        <h1>Principais Artistas</h1>

        <p>
            Conheça alguns dos talentos por trás dos grandes musicais.
        </p>

        <a href="/artistas/cadastrar" class="botao-cadastrar">
            + Cadastrar Artista
        </a>

    </section>

    <section class="artistas-container">

        <% const musicais = ["Death Becomes Her", "Hamilton", "Chicago"]; %>

        <% musicais.forEach((nomeMusical) => { %>

            <section class="grupo-artistas">

                <h2><%= nomeMusical %></h2>

                <div class="cards-artistas">

                    <% artistas
                        .filter((artista) => artista.musical === nomeMusical)
                        .forEach((artista) => { %>

                        <article class="card-artista">

                            <img
                                src="/Images/<%= artista.imagem %>"
                                alt="<%= artista.nome %>"
                            >

                            <div class="card-artista-conteudo">

                                <h3>
                                    <%= artista.nome %>
                                </h3>

                                <p class="personagem">
                                    <%= artista.personagem %>
                                </p>

                                <p class="tipo-vocal">
                                    <%= artista.tipo_vocal %>
                                </p>

                                <div class="acoes-artista">

                                    <a
                                        href="/artistas/editar/<%= artista.id %>"
                                        class="botao-editar"
                                    >
                                        Editar
                                    </a>

                                    <a
                                        href="/artistas/excluir/<%= artista.id %>"
                                        class="botao-excluir"
                                    >
                                        Excluir
                                    </a>

                                </div>

                            </div>

                        </article>

                    <% }); %>

                </div>

            </section>

        <% }); %>

    </section>

</main>

<%- include('partials/footer') %>