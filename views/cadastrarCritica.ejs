<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="pagina-cadastro">

    <section class="titulo-pagina">

        <h1>Cadastrar Crítica</h1>

        <p>
            Adicione uma nova crítica à sua seleção de musicais.
        </p>

    </section>


    <section class="formulario-musical">

        <form action="/criticas/cadastrar" method="POST">

            <div class="campo-formulario">

                <label for="nome">Musical:</label>

                <input
                    type="text"
                    id="nome"
                    name="nome"
                    required
                >

            </div>


            <div class="campo-formulario">

                <label for="critica">Crítica:</label>

                <textarea
                    id="critica"
                    name="critica"
                    required
                ></textarea>

            </div>


            <div class="campo-formulario">

                <label for="nota">Nota:</label>

                <input
                    type="text"
                    id="nota"
                    name="nota"
                    placeholder="Ex.: 9,5/10"
                    required
                >

            </div>


            <div class="campo-formulario">

                <label for="indicações">Indicações:</label>

                <input
                    type="text"
                    id="indicações"
                    name="indicações"
                    placeholder="Ex.: 5 indicações"
                    required
                >

            </div>


            <div class="campo-formulario">

                <label for="premiações">Premiações:</label>

                <input
                    type="text"
                    id="premiações"
                    name="premiações"
                    placeholder="Ex.: 2 prêmios"
                    required
                >

            </div>


            <div class="campo-formulario">

                <label for="imagem">Imagem:</label>

                <input
                    type="text"
                    id="imagem"
                    name="imagem"
                    placeholder="Ex.: dbh.png"
                >

            </div>


            <div class="acoes-formulario">

                <button
                    type="submit"
                    class="botao-cadastrar"
                >
                    Cadastrar
                </button>

                <a
                    href="/criticas"
                    class="botao-voltar"
                >
                    Voltar para críticas
                </a>

            </div>

        </form>

    </section>

</main>

<%- include('partials/footer') %>